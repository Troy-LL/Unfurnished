{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "sh .cursor/hooks/run-fence.sh",
        "matcher": "Write",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "sh .cursor/hooks/run-fence.sh",
        "matcher": "git\\s+(add|commit)|git\\s+-\\S+\\s+(add|commit)",
        "timeout": 10
      }
    ]
  }
}
